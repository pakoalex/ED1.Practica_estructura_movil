<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Contenedor.Vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/margen_item"
    android:paddingTop="@dimen/margen_item">

    <TextView
        android:id="@+id/tvHistExpresion"
        style="@style/Texto.Normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvHistResultado"
        style="@style/Texto.Item.Nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvHistDetalle"
        style="@style/Etiqueta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
