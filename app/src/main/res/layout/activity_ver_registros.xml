<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Fondo.Pantalla"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Fondo.Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            style="@style/Titulo.Pantalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ver_titulo" />

        <EditText
            android:id="@+id/etBuscar"
            style="@style/Campo.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_buscar_nombre"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvVacio"
            style="@style/Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ver_vacio"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPrendas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
